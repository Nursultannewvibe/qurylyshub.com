# ──────────────────────────────────────────────────────────────────
# Qurylys Hub — переменные окружения.
# [ОБЯЗАТЕЛЬНО] — без неё приложение не запустится.
# [ОПЦИОНАЛЬНО] — включает реальный режим провайдера; без неё работает мок.
# ──────────────────────────────────────────────────────────────────

# [ОБЯЗАТЕЛЬНО] Подключение приложения. Роль qurylys_app НЕ имеет UPDATE/DELETE на activity_log (append-only).
DATABASE_URL="postgresql://qurylys_app:qurylys_app@localhost:5432/qurylys?schema=public"
# [ОБЯЗАТЕЛЬНО] Подключение для миграций/сидов (роль-владелец схемы).
DATABASE_MIGRATE_URL="postgresql://qurylys:qurylys@localhost:5432/qurylys?schema=public"

# [ОБЯЗАТЕЛЬНО] Секрет подписи JWT (любая длинная случайная строка).
JWT_SECRET="change-me-to-a-long-random-string"
# [ОПЦИОНАЛЬНО] Срок жизни сессии, по умолчанию 30d.
JWT_TTL="30d"

# [ОПЦИОНАЛЬНО] Публичный URL приложения (для ссылок в уведомлениях/актах).
APP_URL="http://localhost:3000"

# [ОПЦИОНАЛЬНО] Демо-режим: вход под тестовыми аккаунтами одним кликом и виджет переключения ролей.
# Включается при DEMO_MODE=1 ИЛИ при заданном DEV_OTP_CODE. В реальном проде оставьте пустым — эндпоинт
# /api/auth/demo-switch будет отвечать 403 независимо от UI.
DEMO_MODE="1"

# [ОПЦИОНАЛЬНО] Режим OTP. В dev/mock коды не отправляются по SMS, а печатаются в лог сервера
# и (если DEV_OTP_CODE задан) принимается фиксированный код — удобно для тестовых аккаунтов.
DEV_OTP_CODE="000000"

# [ОПЦИОНАЛЬНО] Платёжный шлюз: mock | kaspi | halyk | freedom. Без ключей ниже используется mock.
PAYMENT_PROVIDER="mock"
PAYMENT_FALLBACK_PROVIDER="mock"
KASPI_API_KEY=""
HALYK_EPAY_CLIENT_ID=""
HALYK_EPAY_CLIENT_SECRET=""
FREEDOM_PAY_MERCHANT_ID=""
FREEDOM_PAY_SECRET=""
# [ОПЦИОНАЛЬНО] Секрет проверки подписи вебхуков (мок принимает этот же секрет в заголовке X-Webhook-Secret).
PAYMENT_WEBHOOK_SECRET="mock-webhook-secret"
# [ОПЦИОНАЛЬНО] Только для мока: доля «сбоящих» платежей (0..1), чтобы проверить retry_pending. По умолчанию 0.
MOCK_PAYMENT_FAIL_RATE="0"

# [ОПЦИОНАЛЬНО] Эскроу-провайдер (банковский эскроу-счёт): mock | bank. Реальной интеграции нет.
ESCROW_PROVIDER="mock"
ESCROW_BANK_API_URL=""
ESCROW_BANK_API_KEY=""

# [ОПЦИОНАЛЬНО] Гос-реестры (проверка БИН/лицензий): mock | egov. Реальной интеграции нет.
GOV_REGISTRY_PROVIDER="mock"
EGOV_API_URL=""
EGOV_API_KEY=""

# [ОПЦИОНАЛЬНО] Уведомления: mock | real. В mock всё пишется в notifications + лог сервера.
NOTIFICATION_PROVIDER="mock"
SMS_API_URL=""
SMS_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_ID=""
PUSH_FCM_SERVER_KEY=""

# [ОПЦИОНАЛЬНО] ЭЦП: mock | ncalayer. Мок ставит «подпись» вида mock-sig-<hash>.
SIGNATURE_PROVIDER="mock"

# [ОПЦИОНАЛЬНО] LLM для AI-разбора заявки и AI-саммари отзывов. Без ключа — детерминированный мок.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-5"
# [ОПЦИОНАЛЬНО] Лимит AI-разборов на пользователя в сутки.
AI_PARSE_DAILY_LIMIT="10"

# [ОПЦИОНАЛЬНО] Хранилище файлов. files — локальная папка UPLOAD_DIR; inline — файлы до UPLOAD_INLINE_MAX_MB МБ
# хранятся как data-URL в БД (ВРЕМЕННЫЙ режим для демо на serverless-хостинге, где диск не сохраняется).
UPLOAD_STORAGE="files"
UPLOAD_INLINE_MAX_MB="2"
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB="15"

# [ОПЦИОНАЛЬНО] Встроенный планировщик фоновых задач (rematch, репутация, таймлайн и т.д.): 1 = включён.
SCHEDULER_ENABLED="1"
SCHEDULER_INTERVAL_SEC="60"

# [ОПЦИОНАЛЬНО] Параметры матчинга/лидов.
MATCH_MAX_RECIPIENTS="6"
MATCH_FALLBACK_RADIUS_MULTIPLIER="2"
LEAD_PRICE_DEFAULT="2000"
LEAD_AUTO_REFUND_HOURS="48"
OFFER_REMINDER_DAYS="3"
ACT_SIGN_DEADLINE_DAYS="5"
REVIEW_WINDOW_DAYS="30"
PITCH_EXPIRES_DAYS="7"
